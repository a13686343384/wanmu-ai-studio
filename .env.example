# ------------------------------------------------------------------
# 万幕生 (Manvo TV) 环境变量模板
# 复制为 .env.local 并填入真实值后再运行 npm run dev
# ------------------------------------------------------------------

# 数据库（PostgreSQL）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wanmusheng?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# AI 服务模式：mock | live
# mock = 使用内置假数据，无需任何 API Key（默认）
AI_MODE="mock"

# 真实 AI 端点（仅 AI_MODE=live 时需要）
AI_TEXT_BASE_URL=""
AI_TEXT_API_KEY=""
AI_IMAGE_BASE_URL=""
AI_IMAGE_API_KEY=""
AI_VIDEO_BASE_URL=""
AI_VIDEO_API_KEY=""
AI_AUDIO_BASE_URL=""
AI_AUDIO_API_KEY=""
